{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "functions": {
    "src/app/api/research/route.ts": { "maxDuration": 90 },
    "src/app/api/cron/route.ts": { "maxDuration": 90 },
    "src/app/api/voice/route.ts": { "maxDuration": 60 },
    "src/app/api/upload/route.ts": { "maxDuration": 30 }
  },
  "crons": [{ "path": "/api/cron", "schedule": "0 5 * * *" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
